# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Max file size limit in MB (Telegram Bot API limit is 20MB for download, 50MB for upload)
MAX_FILE_SIZE_MB=50

# Temporary storage directory (relative or absolute)
TEMP_STORAGE_DIR=./temp_downloads

# Automatic cleanup interval in seconds (default: 3600 = 1 hour)
CLEANUP_INTERVAL_SECONDS=3600
