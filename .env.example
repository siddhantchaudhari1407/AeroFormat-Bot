# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Max file size limit in MB (Telegram standard Bot API allows max 20MB download)
MAX_FILE_SIZE_MB=20

# Temporary storage directory (relative or absolute)
TEMP_STORAGE_DIR=./temp_downloads

# Automatic cleanup interval in seconds (default: 3600 = 1 hour)
CLEANUP_INTERVAL_SECONDS=3600
